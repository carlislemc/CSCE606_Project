<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Withdrawal Requests</title>
  <%= stylesheet_link_tag 'tamu', media: 'all', 'data-turbo-track': 'reload' %>
</head>

<body>
  <div class="header">
    <%= image_tag "logo.png", alt: "CSCE Logo", class: "logo" %>
    <%= link_to "logout", logout_path, method: :delete, class: "logout-button" %>
  </div>

  <div class="main-content">
    <h1>Withdrawal Requests</h1>

    <div style="display: flex; gap: 10px; margin-bottom: 16px; flex-wrap: wrap; align-items: center;">
      <%= link_to "Open (#{@open_count})", withdrawal_requests_path(status: "open"), class: "action-button" %>
      <%= link_to "New (#{@new_count})", withdrawal_requests_path(status: "new"), class: "action-button" %>
      <%= link_to "Acknowledged", withdrawal_requests_path(status: "acknowledged"), class: "action-button" %>
      <%= link_to "Resolved", withdrawal_requests_path(status: "resolved"), class: "action-button" %>
    </div>

    <div style="max-height: 800px; overflow-y: auto;">
      <table class="styled-table">
        <thead>
          <tr>
            <th>Status</th>
            <th>Course Number</th>
            <th>Section ID</th>
            <th>Instructor Name</th>
            <th>Instructor Email</th>
            <th>Student Name</th>
            <th>Student Email</th>
            <th>Created</th>
            <th>Acknowledged</th>
            <th>Resolved</th>
            <th>Resolved By</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @withdrawal_requests.each do |request| %>
            <tr style="<%= request.status == 'new' ? 'background-color: #fff4e5;' : '' %>">
              <td>
                <%= request.status.titleize %>
              </td>
              <td><%= request.course_number %></td>
              <td><%= request.section_id %></td>
              <td><%= request.instructor_name %></td>
              <td><%= request.instructor_email %></td>
              <td><%= request.student_name %></td>
              <td><%= request.student_email %></td>
              <td><%= request.created_at&.strftime("%Y-%m-%d %H:%M") %></td>
              <td><%= request.acknowledged_at&.strftime("%Y-%m-%d %H:%M") || "-" %></td>
              <td><%= request.resolved_at&.strftime("%Y-%m-%d %H:%M") || "-" %></td>
              <td><%= request.resolved_by.presence || "-" %></td>
              <td>
                <div style="display: flex; gap: 8px;">
                  <% if request.status == "new" %>
                    <%= button_to "Acknowledge", "/withdrawal_requests/#{request.id}/acknowledge?status=#{@status_filter}", method: :patch, class: "btn btn-warning" %>
                  <% end %>
                  <% unless request.status == "resolved" %>
                    <%= button_to "Resolve", "/withdrawal_requests/#{request.id}/resolve?status=#{@status_filter}", method: :patch, class: "btn btn-success" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div style="margin-top: 20px;">
      <%= link_to "Back to Main Page", root_path, class: "action-button" %>
    </div>
  </div>

  <div class="footer">
    &copy; 2025 Texas A&M University. All Rights Reserved.
  </div>
</body>
</html>
